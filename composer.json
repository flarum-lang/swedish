{
	"name": "flarum-lang/swedish",
	"description": "Swedish Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/swedish",
	"license": "MIT",
	"authors": [
		{
			"name": "Dzenan",
			"homepage": "https://github.com/Dzenan",
			"role": "Maintainer"
		},
		{
			"name": "gustjoha",
			"homepage": "https://github.com/gustjoha",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/swedish/issues",
		"forum": "https://discuss.flarum.org/d/26393",
		"source": "https://github.com/flarum-lang/swedish"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Swedish",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#00247d",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
